<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo do Bargraph -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp"/>
            <solid android:color="#1A2234"/>
            <stroke android:width="1dp" android:color="#2D3B58"/>
        </shape>
    </item>

    <!-- Barra preenchida com gradiente Verde -> Amarelo -> Vermelho estilo VU Meter -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4dp"/>
                <gradient
                    android:startColor="#22C55E"
                    android:centerColor="#EAB308"
                    android:endColor="#EF4444"
                    android:angle="0"/>
            </shape>
        </clip>
    </item>
</layer-list>
