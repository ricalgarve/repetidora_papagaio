<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo da trilha do Bargraph: cinza claro elegante com borda sutil -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="6dp"/>
            <solid android:color="#E2E8F0"/>
            <stroke android:width="1dp" android:color="#CBD5E1"/>
        </shape>
    </item>

    <!-- Barra de preenchimento de alto contraste (Verde Esmeralda) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="6dp"/>
                <solid android:color="#16A34A"/>
            </shape>
        </clip>
    </item>
</layer-list>
